{
  "name": "@danesh/api",
  "version": "0.1.0",
  "description": "Danesh SEO Studio REST API server (Express + SQLite)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --clean --outDir dist",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@danesh/ai-engine": "0.1.0",
    "@danesh/content-analyzer": "0.1.0",
    "@danesh/keyword-research": "0.1.0",
    "@danesh/seo-engine": "0.1.0",
    "@danesh/website-connectors": "0.1.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
