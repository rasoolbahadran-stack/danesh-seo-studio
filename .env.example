# ============================================================
# Danesh SEO Studio — Environment template
# Copy to .env and fill real values. NEVER commit the real .env.
# ============================================================

# ---- Core API server ----
PORT=4000
# SQLite database file (node:sqlite engine, Node >= 22.13 required)
DATABASE_PATH=./data/danesh-seo-studio.db
# IMPORTANT: generate with  openssl rand -hex 48
JWT_SECRET=
# 32-byte hex key used for AES-256-GCM encryption of stored provider API keys.
# IMPORTANT: generate with  openssl rand -hex 32
APP_ENCRYPTION_KEY=
# Comma-separated allowed origins for CORS (dashboard / editor deployments)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info

# ---- Optional default AI provider (OpenAI-compatible) ----
# Can also be configured per-workspace from the dashboard (stored encrypted).
# Examples:
#   Z.ai GLM        : AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  AI_MODEL=glm-4-flash
#   OpenAI          : AI_BASE_URL=https://api.openai.com/v1             AI_MODEL=gpt-4o-mini
#   OpenRouter      : AI_BASE_URL=https://openrouter.ai/api/v1
#   Groq            : AI_BASE_URL=https://api.groq.com/openai/v1
#   Local Ollama    : AI_BASE_URL=http://127.0.0.1:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ---- Optional SERP / keyword-data providers (paid services) ----
# Without these, SERP analysis & real search-volume return a clear
# "not_configured" status — nothing is faked.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_KEY=

# ---- Rate limiting ----
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=10
RATE_LIMIT_AI_PER_MIN=20

# ---- Easy-access owner account (seeded on first start) ----
# Set to false to disable auto-seeding (recommended for public/multi-user deployments)
SEED_DEFAULT_ADMIN=true
SEED_ADMIN_NAME=رسول بهادران
SEED_ADMIN_EMAIL=admin@danesh.local
SEED_ADMIN_PASSWORD=1234
SEED_WORKSPACE_NAME=سایت من
